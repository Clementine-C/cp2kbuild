&GLOBAL
   PROJECT_NAME broken
   RUN_TYPE GEO_OPT
&END GLOBAL
&FORCE_EVAL
   METHOD Quickstep
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT
      POTENTIAL_FILE_NAME GTH_POTENTIALS
      &MGRID
         CUTOFF 300
         REL_CUTOFF 500
      &END MGRID
      &XC
         &XC_FUNCTIONAL PBE
         &END XC_FUNCTIONAL
      &END XC
   &END DFT
   &SUBSYS
      &CELL
         ABC 20 20 20
         PERIODIC NONE
      &END CELL
      &COORD
         Fe 0 0 0
      &END COORD
      &KIND Fe
         ELEMENT Fe
         BASIS_SET DZVP-MOLOPT-SR-GTH
         POTENTIAL GTH-PBE-q8
      &END KIND
   &END SUBSYS
&END FORCE_EVAL
&MOTION
   &GEO_OPT
      OPTIMIZR BFGS
   &END GEO_OPT
&END MOTION
