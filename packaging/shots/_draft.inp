# CP2K input generated by cp2kbuild 0.1.0
# task          : aimd  (RUN_TYPE MD, METHOD QUICKSTEP: Born-Oppenheimer, DFT forces every step)
# system        : OH2  (3 atoms), PERIODIC NONE
# cell          : a=24.0010 b=25.5143 c=24.5861 A, angles 90.00/90.00/90.00 deg
# cell volume   : 15055.76 A^3
# basis/psp     : O:DZVP-MOLOPT-GTH/GTH-PBE-q6, H:DZVP-MOLOPT-GTH/GTH-PBE-q1
# functional    : PBE
# dispersion    : none. Add `--dispersion d3bj` for molecular crystals, adsorption energies and
# layered materials.
# data files    : BASIS_MOLOPT + GTH_POTENTIALS
# run hint      : make sure CP2K finds them, e.g. `export CP2K_DATA_DIR=<cp2k>/data`
# restart       : SCF 初始波函数来自 cp2k-RESTART.wfn（k 点用 .kp）
# restart       : 文件不存在时 CP2K 自己回退到 ATOMIC 初猜（只打一条 warning，不会退出）
# restart       : 本次算完会写 cp2k-RESTART.wfn，下次同名运行直接接着算
# plumed        : 这条路线要一个**编译时带 PLUMED2** 的 CP2K，否则它直接中止（"Requested to use plumed for
# metadynamics, but cp2k was not compiled with plumed support."）；运行时还要能找到 PLUMED 库（否则 "NO PLUMED
# IN YOUR LD_LIBRARY_PATH?"）。CV/丘陵/输出文件都在 water.plumedinp 里
# generated by cp2kbuild

# global run settings
&GLOBAL
   PROJECT_NAME cp2k
   # see https://manual.cp2k.org/cp2k-2026_2-branch/CP2K_INPUT/GLOBAL/RUN_TYPE.html
   RUN_TYPE MD
   PRINT_LEVEL MEDIUM
   # seed of the global random number generator, so that MD initial velocities are reproducible
   SEED 12345
&END GLOBAL

&FORCE_EVAL
   METHOD QUICKSTEP
   # Quickstep electronic structure
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT
      POTENTIAL_FILE_NAME GTH_POTENTIALS
      # plane-wave cutoff of the finest grid; 400 Ry is the usual starting point for this basis set. Converge it with `cp2kbuild scan --cutoffs ...` - https://manual.cp2k.org/cp2k-2026_2-branch/methods/dft/cutoff.html
      &MGRID
         CUTOFF [Ry] 400.0
         REL_CUTOFF [Ry] 60.0
      &END MGRID
      &QS
         METHOD GPW
         EPS_DEFAULT 1.000000E-10
         EXTRAPOLATION ASPC
      &END QS
      # orbital transformation: fast and robust for insulators; https://manual.cp2k.org/cp2k-2026_2-branch/CP2K_INPUT/FORCE_EVAL/DFT/SCF/OT.html
      &SCF
         # previous run's wave function; CP2K falls back to an ATOMIC guess by itself when the file is missing
         SCF_GUESS RESTART
         EPS_SCF 1.000000E-06
         MAX_SCF 30
         &OT
            MINIMIZER DIIS
            PRECONDITIONER FULL_SINGLE_INVERSE
         &END OT
         &OUTER_SCF
            EPS_SCF 1.000000E-06
            MAX_SCF 20
         &END OUTER_SCF
         &PRINT
            # the cp2k-RESTART.wfn file that SCF_GUESS RESTART reads back
            &RESTART ON
               # one dump at the last MD step
               ADD_LAST NUMERIC
               # MD 计数：每多少个 **MD 步**写一次（0 = 跑的过程中不写，只靠 ADD_LAST 在最后一步写）
               &EACH
                  MD 0
               &END EACH
            &END RESTART
         &END PRINT
      &END SCF
      # &POISSON PERIODIC must match the cell periodicity; the default 3-D periodic solver would be inconsistent here
      &POISSON
         PERIODIC NONE
         # MT decouples the periodic images; it needs the density to be confined inside the cell, so keep --vacuum at 8 A or more
         POISSON_SOLVER MT
      &END POISSON
      &XC
         &XC_FUNCTIONAL PBE
         &END XC_FUNCTIONAL
      &END XC
      &PRINT
         # electric dipole moment; meaningless for a fully periodic system, so it is only requested for isolated systems
         &MOMENTS ON
         &END MOMENTS
      &END PRINT
   &END DFT
   &PRINT
      &FORCES ON
      &END FORCES
   &END PRINT
   &SUBSYS
      # simulation cell
      &CELL
         ABC [angstrom] 24.001 25.514272 24.586132
         PERIODIC NONE
      &END CELL
      # atomic coordinates [angstrom]
      &COORD
         O 12.0005 12.757136 12.0
         H 12.0005 12.0 12.586132
         H 12.0005 13.514272 12.586132
      &END COORD
      # O: DZVP-MOLOPT-GTH (q6) + GTH-PBE-q6
      &KIND O
         ELEMENT O
         BASIS_SET DZVP-MOLOPT-GTH
         POTENTIAL GTH-PBE-q6
      &END KIND
      # H: DZVP-MOLOPT-GTH (q1) + GTH-PBE-q1
      &KIND H
         ELEMENT H
         BASIS_SET DZVP-MOLOPT-GTH
         POTENTIAL GTH-PBE-q1
      &END KIND
   &END SUBSYS
&END FORCE_EVAL

&MOTION
   &MD
      ENSEMBLE NVT
      STEPS 20000
      TIMESTEP [fs] 0.5
      # initial velocities are drawn for this temperature; NVT/NPT keep it as the target temperature too; with annealing it is the starting point
      TEMPERATURE [K] 330.0
      &THERMOSTAT
         TYPE CSVR
         &CSVR
            TIMECON [fs] 100.0
         &END CSVR
      &END THERMOSTAT
      &PRINT
         # 墙钟到点或被 EXIT_MD 停下时，把最后一步的 restart/轨迹也写出来（CP2K 默认是 F，会丢掉最后 ≤20 步的落点）
         FORCE_LAST T
      &END PRINT
   &END MD
   &FREE_ENERGY
      # 自由能方法：元动力学
      METHOD METADYN
      &METADYN
         # 把偏置交给外部 PLUMED 驱动：CV 和丘陵都写在 PLUMED 的输入文件里，本段其它参数不生效
         USE_PLUMED T
         PLUMED_INPUT_FILE water.plumedinp
      &END METADYN
   &END FREE_ENERGY
   &PRINT
      # run restart file cp2k-1.restart: what &EXT_RESTART reads back
      &RESTART ON
         # write the last iteration as well
         ADD_LAST NUMERIC
         &EACH
            MD 20
         &END EACH
      &END RESTART
      &TRAJECTORY ON
         &EACH
            MD 10
         &END EACH
      &END TRAJECTORY
      &VELOCITIES ON
      &END VELOCITIES
   &END PRINT
&END MOTION
