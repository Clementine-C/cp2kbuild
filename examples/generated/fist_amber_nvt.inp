# CP2K input generated by cp2kbuild 0.1.0
# task          : classical md  (RUN_TYPE MD, METHOD FIST: the force field is evaluated every
# step, no SCF)
# system        : OH2  (3 atoms), PERIODIC XYZ
# cell          : a=30.0000 b=30.0000 c=30.0000 A, angles 90.00/90.00/90.00 deg
# cell volume   : 27000.00 A^3
# force field   : PARMTYPE AMBER  (AMBER（prmtop + inpcrd/CRD）)
# parameters    : system.prmtop
# topology      : CONNECTIVITY AMBER  system.prmtop
# coordinates   : CRD  system.inpcrd
# 1-4 scaling   : VDW_SCALE14 0.5 / EI_SCALE14 0.8333333333333333  (PARM94 及以后是
# 0.5/0.8333；PARM91 用 0.5/0.5)
# restart       : 本次会写 cp2k-1.restart，用 --restart <该文件> 就能接着算
# generated by cp2kbuild

# global run settings
&GLOBAL
   PROJECT_NAME cp2k
   # see https://manual.cp2k.org/cp2k-2026_2-branch/CP2K_INPUT/GLOBAL/RUN_TYPE.html
   RUN_TYPE MD
   PRINT_LEVEL MEDIUM
&END GLOBAL

# classical force-field calculation: METHOD FIST evaluates no electrons, so there is no &DFT/&QS/&SCF block here
&FORCE_EVAL
   # see https://manual.cp2k.org/cp2k-2026_2-branch/CP2K_INPUT/FORCE_EVAL.html
   METHOD FIST
   # classical force field (no electrons are computed); https://manual.cp2k.org/cp2k-2026_2-branch/CP2K_INPUT/FORCE_EVAL/MM.html
   &MM
      # AMBER 拓扑（prmtop，%VERSION / %FLAG 那种）在 &TOPOLOGY 里读连接性
      &FORCEFIELD
         # CP2K's PARMTYPE for AMBER: AMBER（prmtop + inpcrd/CRD）
         PARMTYPE AMBER
         PARM_FILE_NAME system.prmtop
         # PARM94 及以后是 0.5/0.8333；PARM91 用 0.5/0.5
         VDW_SCALE14 0.5
         EI_SCALE14 0.833333333333
      &END FORCEFIELD
      &POISSON
         # SPME is the smooth particle mesh Ewald CP2K recommends
         &EWALD
            EWALD_TYPE SPME
            # G-space max. Miller index; CP2K has no default for it
            GMAX 64
         &END EWALD
      &END POISSON
   &END MM
   &PRINT
      &FORCES ON
      &END FORCES
   &END PRINT
   &SUBSYS
      # simulation cell
      &CELL
         ABC [angstrom] 30.0 30.0 30.0
         PERIODIC XYZ
      &END CELL
      # https://manual.cp2k.org/cp2k-2026_2-branch/CP2K_INPUT/FORCE_EVAL/SUBSYS/TOPOLOGY.html
      &TOPOLOGY
         CONNECTIVITY AMBER
         CONN_FILE_NAME system.prmtop
         # CRD 是 AMBER 的坐标格式（inpcrd / restart）
         COORDINATE CRD
         COORD_FILE_NAME system.inpcrd
      &END TOPOLOGY
   &END SUBSYS
&END FORCE_EVAL

&MOTION
   &MD
      ENSEMBLE NVT
      STEPS 100000
      TIMESTEP [fs] 1.0
      # initial velocities are drawn for this temperature; NVT/NPT keep it as the target temperature too
      TEMPERATURE [K] 300.0
      &THERMOSTAT
         TYPE NOSE
         &NOSE
            TIMECON [fs] 100.0
         &END NOSE
      &END THERMOSTAT
   &END MD
   &PRINT
      # run restart file cp2k-1.restart: what &EXT_RESTART reads back
      &RESTART ON
         # write the last iteration as well
         ADD_LAST NUMERIC
         &EACH
            MD 20
         &END EACH
      &END RESTART
      &TRAJECTORY ON
         &EACH
            MD 10
         &END EACH
      &END TRAJECTORY
      &VELOCITIES ON
      &END VELOCITIES
   &END PRINT
&END MOTION
