# CP2K input generated by cp2kbuild 0.1.0
# task          : classical md  (RUN_TYPE MD, METHOD FIST: the force field is evaluated every
# step, no SCF)
# system        : Ar108  (108 atoms), PERIODIC XYZ
# cell          : a=15.7800 b=15.7800 c=15.7800 A, angles 90.00/90.00/90.00 deg
# cell volume   : 3929.35 A^3
# force field   : PARMTYPE OFF  (只有对势（ε/σ/RCUT，Ar 那种）)
# restart       : 本次会写 cp2k-1.restart，用 --restart <该文件> 就能接着算
# generated by cp2kbuild

# global run settings
&GLOBAL
   PROJECT_NAME cp2k
   # see https://manual.cp2k.org/cp2k-2026_2-branch/CP2K_INPUT/GLOBAL/RUN_TYPE.html
   RUN_TYPE MD
   PRINT_LEVEL MEDIUM
&END GLOBAL

# classical force-field calculation: METHOD FIST evaluates no electrons, so there is no &DFT/&QS/&SCF block here
&FORCE_EVAL
   # see https://manual.cp2k.org/cp2k-2026_2-branch/CP2K_INPUT/FORCE_EVAL.html
   METHOD FIST
   # classical force field (no electrons are computed); https://manual.cp2k.org/cp2k-2026_2-branch/CP2K_INPUT/FORCE_EVAL/MM.html
   &MM
      # 纯对势体系：只给 &CHARGE 和 &NONBONDED &LENNARD-JONES，没有键角项
      &FORCEFIELD
         # CP2K's PARMTYPE for PAIR: 只有对势（ε/σ/RCUT，Ar 那种）
         PARMTYPE OFF
         &CHARGE
            ATOM Ar
            CHARGE 0.0
         &END CHARGE
         # LJ parameters: EPSILON in K, SIGMA and RCUT in angstrom
         &NONBONDED
            &LENNARD-JONES
               ATOMS Ar Ar
               EPSILON [K] 119.8
               SIGMA [angstrom] 3.405
               RCUT [angstrom] 8.4
            &END LENNARD-JONES
         &END NONBONDED
      &END FORCEFIELD
      &POISSON
         # EWALD_TYPE NONE keeps only the real-space Coulomb sum: right for a neutral system with no charges, and right for an isolated molecule - wrong for a periodic solution
         &EWALD
            EWALD_TYPE NONE
         &END EWALD
      &END POISSON
   &END MM
   &PRINT
      &FORCES ON
      &END FORCES
   &END PRINT
   &SUBSYS
      # simulation cell
      &CELL
         ABC [angstrom] 15.78 15.78 15.78
         PERIODIC XYZ
      &END CELL
      # https://manual.cp2k.org/cp2k-2026_2-branch/CP2K_INPUT/FORCE_EVAL/SUBSYS/TOPOLOGY.html
      &TOPOLOGY
         # GENERATE 按距离判断成键；这是 CP2K 的默认值
         CONNECTIVITY GENERATE
      &END TOPOLOGY
      # atomic coordinates [angstrom]
      &COORD
         Ar 0.0 0.0 0.0
         Ar 0.0 2.63 2.63
         Ar 2.63 0.0 2.63
         Ar 2.63 2.63 0.0
         Ar 0.0 0.0 5.26
         Ar 0.0 2.63 7.89
         Ar 2.63 0.0 7.89
         Ar 2.63 2.63 5.26
         Ar 0.0 0.0 10.52
         Ar 0.0 2.63 13.15
         Ar 2.63 0.0 13.15
         Ar 2.63 2.63 10.52
         Ar 0.0 5.26 0.0
         Ar 0.0 7.89 2.63
         Ar 2.63 5.26 2.63
         Ar 2.63 7.89 0.0
         Ar 0.0 5.26 5.26
         Ar 0.0 7.89 7.89
         Ar 2.63 5.26 7.89
         Ar 2.63 7.89 5.26
