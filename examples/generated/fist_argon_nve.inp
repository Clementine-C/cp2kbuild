         Ar 13.15 13.15 10.52
      &END COORD
   &END SUBSYS
&END FORCE_EVAL

&MOTION
   &MD
      ENSEMBLE NVE
      STEPS 10000
      TIMESTEP [fs] 5.0
      # initial velocities are drawn for this temperature; NVT/NPT keep it as the target temperature too
      TEMPERATURE [K] 85.0
   &END MD
   &PRINT
      # run restart file cp2k-1.restart: what &EXT_RESTART reads back
      &RESTART ON
         # write the last iteration as well
         ADD_LAST NUMERIC
         &EACH
            MD 20
         &END EACH
      &END RESTART
      &TRAJECTORY ON
         &EACH
            MD 10
         &END EACH
      &END TRAJECTORY
      &VELOCITIES ON
      &END VELOCITIES
   &END PRINT
&END MOTION
