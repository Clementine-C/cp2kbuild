# CP2K input generated by cp2kbuild 0.1.0
# task          : pdos  (RUN_TYPE ENERGY)
# system        : Si8  (8 atoms), PERIODIC XYZ
# cell          : a=5.4300 b=5.4300 c=5.4300 A, angles 90.00/90.00/90.00 deg
# cell volume   : 160.10 A^3
# basis/psp     : Si:DZVP-MOLOPT-SR-GTH/GTH-PBE-q4
# functional    : PBE
# data files    : BASIS_MOLOPT + GTH_POTENTIALS
# run hint      : make sure CP2K finds them, e.g. `export CP2K_DATA_DIR=<cp2k>/data`
# restart       : SCF 初始波函数来自 cp2k-RESTART.wfn（k 点用 .kp）
# restart       : 文件不存在时 CP2K 自己回退到 ATOMIC 初猜（只打一条 warning，不会退出）
# restart       : 本次算完会写 cp2k-RESTART.wfn，下次同名运行直接接着算
# generated by cp2kbuild

# global run settings
&GLOBAL
   PROJECT_NAME cp2k
   # see https://manual.cp2k.org/cp2k-2026_2-branch/CP2K_INPUT/GLOBAL/RUN_TYPE.html
   RUN_TYPE ENERGY
   PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
   METHOD QUICKSTEP
   # Quickstep electronic structure
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT
      POTENTIAL_FILE_NAME GTH_POTENTIALS
      # plane-wave cutoff of the finest grid; 400 Ry is the usual starting point for this basis set. Converge it with `cp2kbuild scan --cutoffs ...` - https://manual.cp2k.org/cp2k-2026_2-branch/methods/dft/cutoff.html
      &MGRID
         CUTOFF [Ry] 400.0
         REL_CUTOFF [Ry] 60.0
      &END MGRID
      &QS
         METHOD GPW
         EPS_DEFAULT 1.000000E-10
         EXTRAPOLATION USE_GUESS
      &END QS
      # diagonalisation route: needed for k-points, smearing and unoccupied states
      &SCF
         # previous run's wave function; CP2K falls back to an ATOMIC guess by itself when the file is missing
         SCF_GUESS RESTART
         EPS_SCF 1.000000E-06
         MAX_SCF 30
         ADDED_MOS 10
         &DIAGONALIZATION
            ALGORITHM STANDARD
         &END DIAGONALIZATION
         &MIXING
            METHOD BROYDEN_MIXING
            ALPHA 0.4
            NBUFFER 8
         &END MIXING
         &PRINT
            # the cp2k-RESTART.kp file that SCF_GUESS RESTART reads back (k-point runs use .kp, not .wfn)
            &RESTART ON
               # one dump at the last SCF step
               ADD_LAST NUMERIC
               &EACH
                  QS_SCF 0
               &END EACH
            &END RESTART
         &END PRINT
      &END SCF
      &XC
         &XC_FUNCTIONAL PBE
         &END XC_FUNCTIONAL
      &END XC
      &PRINT
         &DOS
            NLUMO 10
            # total projected DOS; add COMPONENTS to split it
            &PDOS
            &END PDOS
            &LDOS
               LIST 1 2 3
            &END LDOS
         &END DOS
      &END PRINT
      # Brillouin-zone sampling for the SCF density
      &KPOINTS
         SCHEME MONKHORST-PACK 4 4 4
         # reduce the mesh with the crystal symmetry
         SYMMETRY T
         # real wavefunctions are enough unless the k-point set needs phases (spin-orbit coupling); CP2K's own default is COMPLEX
         WAVEFUNCTIONS REAL
      &END KPOINTS
   &END DFT
   &PRINT
      &FORCES ON
      &END FORCES
   &END PRINT
   &SUBSYS
      # simulation cell
      &CELL
         ABC [angstrom] 5.43 5.43 5.43
         PERIODIC XYZ
      &END CELL
      # atomic coordinates [angstrom]
      &COORD
         Si 0.0 0.0 0.0
         Si 0.0 2.715 2.715
         Si 2.715 0.0 2.715
         Si 2.715 2.715 0.0
         Si 1.3575 1.3575 1.3575
         Si 1.3575 4.0725 4.0725
         Si 4.0725 1.3575 4.0725
         Si 4.0725 4.0725 1.3575
      &END COORD
      # Si: DZVP-MOLOPT-SR-GTH (q4) + GTH-PBE-q4
      &KIND Si
         ELEMENT Si
         BASIS_SET DZVP-MOLOPT-SR-GTH
         POTENTIAL GTH-PBE-q4
      &END KIND
   &END SUBSYS
&END FORCE_EVAL
