# CP2K input generated by cp2kbuild 0.1.0
# task          : classical md  (RUN_TYPE MD, METHOD FIST: the force field is evaluated every
# step, no SCF)
# system        : OH2  (3 atoms), PERIODIC XYZ
# cell          : a=9.8650 b=9.8650 c=9.8650 A, angles 90.00/90.00/90.00 deg
# cell volume   : 960.04 A^3
# force field   : PARMTYPE OFF  (参数写在输入里（PARMTYPE OFF）)
# force-field terms written into the input, taken from fist_water_ff.inc
# restart       : 本次会写 cp2k-1.restart，用 --restart <该文件> 就能接着算
# generated by cp2kbuild

# global run settings
&GLOBAL
   PROJECT_NAME cp2k
   # see https://manual.cp2k.org/cp2k-2026_2-branch/CP2K_INPUT/GLOBAL/RUN_TYPE.html
   RUN_TYPE MD
   PRINT_LEVEL MEDIUM
&END GLOBAL

# classical force-field calculation: METHOD FIST evaluates no electrons, so there is no &DFT/&QS/&SCF block here
&FORCE_EVAL
   # see https://manual.cp2k.org/cp2k-2026_2-branch/CP2K_INPUT/FORCE_EVAL.html
   METHOD FIST
   # classical force field (no electrons are computed); https://manual.cp2k.org/cp2k-2026_2-branch/CP2K_INPUT/FORCE_EVAL/MM.html
   &MM
      # 力场参数直接写在 &FORCEFIELD 里：&CHARGE/&BOND/&BEND/&NONBONDED
      # 读不到力场文件 fist_water_ff.inc（No such file or directory）：把 &CHARGE/&BOND/&BEND/&NONBONDED 条款补在这里，或修好 --mm-ff-file 的路径
      &FORCEFIELD
         # CP2K's PARMTYPE for IN_INPUT: 参数写在输入里（PARMTYPE OFF）
         PARMTYPE OFF
         &CHARGE
            ATOM O
            CHARGE 0.0
         &END CHARGE
         &CHARGE
            ATOM H
            CHARGE 0.0
         &END CHARGE
         # 还差 ε/σ：这里只列出了元素对，EPSILON/SIGMA 需要你按力场补上，否则 LJ 吸引项等于 0
         &NONBONDED
            &LENNARD-JONES
               ATOMS O O
            &END LENNARD-JONES
            &LENNARD-JONES
               ATOMS O H
            &END LENNARD-JONES
            &LENNARD-JONES
               ATOMS H H
            &END LENNARD-JONES
         &END NONBONDED
      &END FORCEFIELD
      &POISSON
         # SPME is the smooth particle mesh Ewald CP2K recommends
         &EWALD
            EWALD_TYPE SPME
            # G-space max. Miller index; CP2K has no default for it
            GMAX 20
            # interpolation order of the mesh; 6 is fast and accurate
            O_SPLINE 6
         &END EWALD
      &END POISSON
   &END MM
   &PRINT
      &FORCES ON
      &END FORCES
   &END PRINT
   &SUBSYS
      # simulation cell
      &CELL
         ABC [angstrom] 9.865 9.865 9.865
         PERIODIC XYZ
      &END CELL
      # https://manual.cp2k.org/cp2k-2026_2-branch/CP2K_INPUT/FORCE_EVAL/SUBSYS/TOPOLOGY.html
      &TOPOLOGY
         # GENERATE 按距离判断成键；这是 CP2K 的默认值
         CONNECTIVITY GENERATE
      &END TOPOLOGY
      # atomic coordinates [angstrom]
      &COORD
         O 0.0 0.0 -0.065587
         H 0.0 -0.757136 0.520545
         H 0.0 0.757136 0.520545
      &END COORD
   &END SUBSYS
&END FORCE_EVAL

&MOTION
   &MD
      ENSEMBLE NVT
      STEPS 10000
      TIMESTEP [fs] 0.5
      # initial velocities are drawn for this temperature; NVT/NPT keep it as the target temperature too
      TEMPERATURE [K] 300.0
      &THERMOSTAT
         TYPE NOSE
         &NOSE
            TIMECON [fs] 100.0
         &END NOSE
      &END THERMOSTAT
   &END MD
   &PRINT
      # run restart file cp2k-1.restart: what &EXT_RESTART reads back
      &RESTART ON
         # write the last iteration as well
         ADD_LAST NUMERIC
         &EACH
            MD 20
         &END EACH
      &END RESTART
      &TRAJECTORY ON
         &EACH
            MD 10
         &END EACH
      &END TRAJECTORY
      &VELOCITIES ON
      &END VELOCITIES
   &END PRINT
&END MOTION
