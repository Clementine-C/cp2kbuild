# ============================================================
# CP2K 2026.2 + PLUMED 2.9.2
# Urea-urea condensation CV
#
# System:
#   atoms 1-19   : 4-CPBA
#   atoms 20-179  : 20 urea molecules
#
# Urea atom pattern:
#   U1  = N20  C21  N22
#   U2  = N28  C29  N30
#   ...
#   U20 = N172 C173 N174
#
# CV_UU:
#   Sum of C-N coordination numbers between DIFFERENT urea
#   molecules only.
#
# Intramolecular urea C-N pairs are explicitly excluded.
# ============================================================

UNITS LENGTH=A TIME=fs ENERGY=kj/mol

# ------------------------------------------------------------
# Urea 1: C21
# Exclude N20 and N22 from the same urea
# ------------------------------------------------------------
c1: COORDINATION GROUPA=21 GROUPB=28,30,36,38,44,46,52,54,60,62,68,70,76,78,84,86,92,94,100,102,108,110,116,118,124,126,132,134,140,142,148,150,156,158,164,166,172,174 R_0=1.55 NN=12 MM=24

# Urea 2: C29
c2: COORDINATION GROUPA=29 GROUPB=20,22,36,38,44,46,52,54,60,62,68,70,76,78,84,86,92,94,100,102,108,110,116,118,124,126,132,134,140,142,148,150,156,158,164,166,172,174 R_0=1.55 NN=12 MM=24

